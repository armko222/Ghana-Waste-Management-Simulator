# Build output
target/
*.class
# Regenerated by maven-shade on every `mvn package` — never commit
dependency-reduced-pom.xml

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Editor backups/swap
*~
*.swp

# JVM crash dumps (Issue #14's timing loops can produce these)
hs_err_pid*.log
replay_pid*.log

# Database (generated locally — schema.sql recreates it; don't commit data)
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Generated performance results (regenerate via the experiment harness;
# commit only the final curated results before submission, not every local run)
results/*.csv
!results/.gitkeep
